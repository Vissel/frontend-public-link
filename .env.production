# Public origin + gateway context path. Nginx maps
#   https://share-link.top/apiGateway/*  ->  apiGateway (127.0.0.1:8080)
# Never use localhost here: this value is baked into the JS bundle and is
# resolved by the visitor's browser, not by the server.
REACT_APP_API_BASE_URL=https://share-link.top/apiGateway
