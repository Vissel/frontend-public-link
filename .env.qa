# QA frontend build against the Windows Tomcat machine on the LAN.
# `npm run build` reads .env.production, so the QA build overrides the value on
# the command line (a shell env var wins over .env files in CRA):
#   REACT_APP_API_BASE_URL=http://WIN_IP:8080/apiGateway npm run build
# Keep this file in sync with the value used in the actual QA build.
REACT_APP_API_BASE_URL=http://192.168.1.9:8080/apiGateway
