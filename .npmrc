# react-scripts@5.0.1 accepts typescript ^3.2.1 || ^4, while i18next@26.x
# declares an optional peer typescript ^5 || ^6. npm auto-installs the optional
# peer (typescript 6) and then hard-fails ERESOLVE against react-scripts.
# This is a plain-JS CRA app (no .ts/.tsx files) — TypeScript is never used,
# so skip the conflicting optional-peer resolution for every npm command.
legacy-peer-deps=true
