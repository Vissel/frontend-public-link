<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PublicLink Frontend</display-name>

    <!--
        SPA Fallback Configuration for React BrowserRouter.

        With React BrowserRouter, all frontend routes (e.g. /link, /login, /adminHome)
        are handled by client-side routing. When a user directly accesses a route URL
        (e.g. http://host/publiclink/link?reqId=...), Tomcat attempts to find a
        matching resource and returns 404.

        This error-page rule catches ALL 404 responses and serves index.html, allowing
        the React router to handle the route on the client side.

        IMPORTANT: Place this file at:
          - WAR deployment: WEB-INF/web.xml (inside your WAR archive)
          - Standalone: $CATALINA_HOME/webapps/<app>/WEB-INF/web.xml
    -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
